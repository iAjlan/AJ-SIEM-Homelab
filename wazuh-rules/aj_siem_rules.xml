<group name="aj_siem,">

  <!-- =========================================================
       CASE 01: RDP Brute Force
       Source: Windows Security Event 4625
       MITRE ATT&CK: T1110.001
       ========================================================= -->

  <rule id="100101" level="12" frequency="5" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>AJ SIEM: RDP brute-force detected from $(win.eventdata.ipAddress) against $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>windows,authentication_failed,rdp_bruteforce,case_01,</group>
  </rule>


  <!-- =========================================================
       CASE 02: SQL Injection Against IIS
       Source: Microsoft IIS W3C access logs
       MITRE ATT&CK: T1190
       ========================================================= -->

  <!-- Warning: Detect one high-confidence SQL injection request -->
  <rule id="110201" level="10">
    <if_sid>31108</if_sid>
<url type="pcre2">(?i)(%27|')(%20|\+)+(or|and)(%20|\+)+.*(%3d|=)</url>
     <description>AJ SIEM: SQL injection pattern detected from $(srcip) against IIS: $(url)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,sql_injection,case_02,</group>
  </rule>

  <!-- Active Response trigger: Three attempts in 60 seconds -->
  <rule id="110202" level="13" frequency="3" timeframe="60">
    <if_matched_sid>110201</if_matched_sid>
    <same_srcip />
    <description>AJ SIEM: Repeated SQL injection attempts from $(srcip) against IIS</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>web,attack,sql_injection,active_response,case_02,</group>
  </rule>

<!-- =========================================================
     CASE 03: Directory Traversal Against IIS
     Source: Microsoft IIS W3C access logs
     MITRE ATT&CK: T1190
     Response: Alert only
     ========================================================= -->

<rule id="110301" level="10">
  <if_sid>31108</if_sid>
  <url type="pcre2">(?i)(?:\.\.|%2e%2e)(?:/|%2f|\\|%5c)</url>
  <description>AJ SIEM: Directory traversal attempt from $(srcip) against IIS: $(url)</description>
  <mitre>
    <id>T1190</id>
  </mitre>
  <group>web,attack,directory_traversal,case_03,</group>
</rule>
<!-- =========================================================
     CASE 04: Suspicious Outbound C2 Connection
     Source: Sysmon Event 3
     MITRE ATT&CK: T1071.001
     Response: Alert + Block destination IP
     ========================================================= -->

<rule id="110401" level="13">
  <if_sid>61605</if_sid>
  <field name="win.eventdata.destinationIp" type="pcre2">^192\.168\.72\.131$</field>
  <field name="win.eventdata.destinationPort" type="pcre2">^8080$</field>
  <description>AJ SIEM: Suspicious outbound C2 connection from $(win.eventdata.sourceIp) to $(win.eventdata.destinationIp):$(win.eventdata.destinationPort) by $(win.eventdata.image)</description>
  <mitre>
    <id>T1071.001</id>
  </mitre>
  <group>sysmon,network,c2,suspicious_outbound,active_response,case_04,</group>
</rule>
  <!-- Active Response status for C2 blocking -->
  <rule id="110411" level="10">
    <match>block-c2.ps1: Blocked outbound C2 destination</match>
    <description>AJ SIEM: Active Response blocked the suspicious C2 destination</description>
    <group>active_response,c2,blocked,</group>
  </rule>

  <rule id="110412" level="5">
    <match>block-c2.ps1: Removed outbound C2 block</match>
    <description>AJ SIEM: Active Response automatically removed the C2 block after timeout</description>
    <group>active_response,c2,unblocked,</group>
  </rule>

  <!-- =========================================================
       CASE 05: Suspicious DNS / DNS Tunneling
       Source: Sysmon Event 22
       ========================================================= -->

  <rule id="110501" level="11">
    <if_sid>61650</if_sid>
    <field name="win.eventdata.queryName" type="pcre2">(?i)(?:^|\.)[a-z0-9_-]{45,}(?:\.|$)</field>
    <description>AJ SIEM: Suspicious DNS query with unusually long encoded-looking subdomain: $(win.eventdata.queryName) by $(win.eventdata.image)</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <group>sysmon,dns,dns_tunneling,suspicious_dns,case_05,</group>
  </rule>

  <!-- Escalation: Repeated suspicious DNS queries by the same process -->
  <rule id="110502" level="14" frequency="5" timeframe="60">
    <if_matched_sid>110501</if_matched_sid>
    <same_field>win.eventdata.processGuid</same_field>
    <description>AJ SIEM: Probable DNS tunneling detected - repeated long DNS queries by $(win.eventdata.image)</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
    <group>sysmon,dns,dns_tunneling,probable_dns_tunnel,case_05,</group>
  </rule>
  <!-- Active Response status: DNS tunneling process terminated -->
  <rule id="110511" level="10">
    <match>kill-dns-tunnel.ps1: Terminated probable DNS tunneling process</match>
    <description>AJ SIEM: Active Response terminated the probable DNS tunneling process</description>
    <group>active_response,dns,dns_tunneling,process_terminated,case_05,</group>
  </rule>

<!-- =========================================================
     CASE 06: Potential IIS Web Shell File Drop
     Source: Wazuh FIM - Rule 554
     ========================================================= -->

<rule id="110601" level="10">
  <if_sid>554</if_sid>
  <field name="file" type="pcre2">(?i)^c:\\inetpub\\wwwroot\\.*\.(?:asp|aspx|ashx|asmx)$</field>
  <description>AJ SIEM: Potential web shell file added to IIS web root: $(file)</description> 
 <mitre> <id>T1505.003</id> </mitre>
  <group>iis,webshell,fim,file_drop,persistence,case_06,</group>
</rule>

<!-- Escalation: Successful web-shell-like request through IIS -->
<rule id="110602" level="13">
  <if_sid>31108</if_sid>
  <url type="pcre2">(?i)\.(?:asp|aspx|ashx|asmx)\s+(?:cmd|exec|command|shell)=</url>
  <description>AJ SIEM: High-confidence IIS web shell-like request detected from $(srcip): $(url)</description>
  <mitre>
    <id>T1505.003</id>
  </mitre>
  <group>iis,webshell,web_access,high_confidence,case_06,</group>
</rule>
<!-- =========================================================
     CASE 07: IIS Worker Process Spawning Command Shell
     Source: Sysmon Event 1
     MITRE ATT&CK: T1059.003 / T1059.001
     Response: Alert first
     ========================================================= -->

<rule id="110701" level="14">
  <if_group>sysmon_event1</if_group>
  <field name="win.eventdata.parentImage" type="pcre2">(?i)w3wp\.exe$</field>
<field name="win.eventdata.image" type="pcre2">(?i)(cmd|powershell)\.exe$</field>
  <description>AJ SIEM: IIS worker process spawned command shell: $(win.eventdata.parentImage) -> $(win.eventdata.image) | CMD: $(win.eventdata.commandLine)</description>
  <mitre>
    <id>T1059.003</id>
    <id>T1059.001</id>
  </mitre>
  <group>iis,process_creation,webshell_execution,command_shell,high_confidence,case_07,</group>

</rule>
<rule id="110711" level="10">
  <match>kill-iis-child.ps1: Terminated IIS child process</match>
  <description>AJ SIEM: Active Response terminated suspicious IIS child process</description>
  <group>active_response,iis,process_terminated,case_07,</group>
</rule>

