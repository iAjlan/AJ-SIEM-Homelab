<!-- =========================================================
     CASE 10: Encoded PowerShell Execution
     Detects PowerShell launched with Base64 encoded commands.
     Attackers commonly use -EncodedCommand to hide the real
     command from simple inspection and logging.

     Source: Wazuh built-in rule 92057 / Sysmon Event ID 1
     MITRE ATT&CK: T1059.001 - PowerShell
     Severity: Critical
     Active Response: Terminate encoded PowerShell process
     ========================================================= -->

<rule id="111001" level="15">
  <if_group>sysmon_event1</if_group>

  <field name="win.eventdata.image" type="pcre2">(?i)powershell[.]exe$</field>
  <field name="win.eventdata.commandLine" type="pcre2">(?i)-(encodedcommand|e|ea|ec|encodeda|encode|en|enco)( |$)</field>

  <description>AJ SIEM: High-confidence encoded PowerShell execution detected | CMD: $(win.eventdata.commandLine)</description>

  <mitre>
    <id>T1059.001</id>
  </mitre>

  <group>powershell,encoded_command,execution,high_confidence,case_10,</group>
</rule>

<!-- =========================================================
     CASE 10: Active Response Confirmation
     Confirms that AJ SIEM terminated the encoded
     PowerShell process successfully.
     ========================================================= -->

<rule id="111011" level="10">
  <match>kill-encoded-powershell.ps1: Terminated encoded PowerShell process</match>

  <description>AJ SIEM: Active Response terminated encoded PowerShell process</description>

  <group>active_response,powershell,encoded_command,process_terminated,case_10,</group>
</rule>

