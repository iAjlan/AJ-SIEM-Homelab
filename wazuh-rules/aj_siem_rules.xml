<!-- =========================================================
     CASE 12: MSHTA Remote HTA Execution
     Detects mshta.exe executing a remote HTA file over
     HTTP/HTTPS. This behavior is commonly abused for
     proxy execution of malicious script content.

     Source: Sysmon Event ID 1 - Process Creation
     MITRE ATT&CK: T1218.005 - Mshta
     Severity: Critical
     Active Response: Terminate suspicious mshta.exe process
     ========================================================= -->

<rule id="111201" level="15">
  <if_group>sysmon_event1</if_group>

  <field name="win.eventdata.image" type="pcre2">(?i)\\mshta\.exe$</field>

  <field name="win.eventdata.commandLine" type="pcre2">(?i)https?://[^\s"]+\.hta(?:\s|$)</field>

  <description>AJ SIEM: High-confidence remote HTA execution detected via mshta.exe | CMD: $(win.eventdata.commandLine)</description>

  <mitre>
    <id>T1218.005</id>
  </mitre>

  <group>execution,defense_evasion,mshta,hta,lolbin,high_confidence,case_12,</group>
</rule>

<!-- =========================================================
     CASE 12: Active Response Confirmation
     Confirms that AJ SIEM terminated the suspicious
     remote HTA mshta.exe process.
     ========================================================= -->

<rule id="111211" level="10">
  <match>kill-mshta.ps1: Terminated remote HTA mshta process</match>

  <description>AJ SIEM: Active Response terminated suspicious remote HTA mshta process</description>

  <group>active_response,mshta,hta,process_terminated,case_12,</group>
</rule>

